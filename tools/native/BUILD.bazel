load("@python_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")

exports_files(
    ["install.py"],
    visibility = ["//tools:__pkg__"],
)

py_binary(
    name = "wheel_builder",
    srcs = ["wheel.py"],
    main = "wheel.py",
)

# Add component-owned extensions/resources here; launch/install code stays generic.
genrule(
    name = "wheel",
    srcs = ["//src/robo_arch/core/controllers/joint_pd:bindings_import/robo_arch_native/_joint_pd.so"],
    outs = ["robo_arch_native-0.1.0-cp312-cp312-linux_x86_64.whl"],
    cmd = "$(execpath :wheel_builder) $@ --extension robo_arch_native._joint_pd $(execpath //src/robo_arch/core/controllers/joint_pd:bindings_import/robo_arch_native/_joint_pd.so)",
    tools = [":wheel_builder"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "install_test",
    srcs = [
        "install.py",
        "tests/test_install.py",
    ],
    main = "tests/test_install.py",
    deps = [requirement("pytest")],
)

py_test(
    name = "wheel_test",
    srcs = [
        "tests/test_wheel.py",
        "wheel.py",
    ],
    main = "tests/test_wheel.py",
    deps = [requirement("pytest")],
)
