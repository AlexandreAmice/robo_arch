load("@python_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":defs.bzl", "native_wheels")

exports_files(
    ["install.py"],
    visibility = ["//tools:__pkg__"],
)

py_binary(
    name = "wheel_builder",
    srcs = ["wheel.py"],
    main = "wheel.py",
)

# Add component-owned extensions/resources here; launch/install code stays generic.
config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

native_wheels(
    name = "wheel",
    extensions = {
        "robo_arch_native._joint_pd": "//src/robo_arch/core/controllers/joint_pd:bindings_import/robo_arch_native/_joint_pd.so",
    },
)

py_test(
    name = "install_test",
    srcs = [
        "install.py",
        "tests/test_install.py",
    ],
    main = "tests/test_install.py",
    deps = [requirement("pytest")],
)

py_test(
    name = "wheel_test",
    srcs = [
        "tests/test_wheel.py",
        "wheel.py",
    ],
    main = "tests/test_wheel.py",
    deps = [requirement("pytest")],
)
