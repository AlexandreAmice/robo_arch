load("@python_deps//:requirements.bzl", "requirement")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_library", "py_test")
load("//tools/docs:defs.bzl", "cpp_docstrings")

cpp_docstrings(
    name = "generated_docstrings",
    cpp = "generated/docstrings.h",
    header = "joint_pd.h",
    library = ":joint_pd_cc",
    manifest = "docstrings.json",
    python = "generated/_docstrings.py",
)

genrule(
    name = "checked_docstrings",
    srcs = [
        "generated/docstrings.h",
        "generated/_docstrings.py",
        "_docstrings.py",
    ],
    outs = ["docstrings.h"],
    cmd = "cmp $(execpath generated/_docstrings.py) $(execpath _docstrings.py) || { echo 'Stale docstrings: see docs/build_and_layout.md#api-documentation' >&2; exit 1; }; cp $(execpath generated/docstrings.h) $@",
)

cc_library(
    name = "docstrings",
    hdrs = [":checked_docstrings"],
    strip_include_prefix = "/src",
)

cc_library(
    name = "joint_pd_cc",
    srcs = ["joint_pd.cc"],
    hdrs = ["joint_pd.h"],
    strip_include_prefix = "/src",
    visibility = ["//src/robo_arch:__subpackages__"],
)

cc_binary(
    name = "bindings_import/robo_arch_native/_joint_pd.so",
    srcs = ["bindings.cc"],
    copts = ["-fvisibility=hidden"],
    linkopts = select({
        "@platforms//os:macos": [
            "-undefined",
            "dynamic_lookup",
        ],
        "//conditions:default": ["-Wl,--exclude-libs,ALL"],
    }),
    linkshared = True,
    linkstatic = True,
    visibility = ["//tools/native:__pkg__"],
    deps = [
        ":docstrings",
        ":joint_pd_cc",
        "@nanobind",
    ],
)

genrule(
    name = "native_init",
    outs = ["bindings_import/robo_arch_native/__init__.py"],
    cmd = "touch $@",
)

py_library(
    name = "extension",
    srcs = [":native_init"],
    data = [":bindings_import/robo_arch_native/_joint_pd.so"],
    imports = ["bindings_import"],
)

py_library(
    name = "joint_pd",
    srcs = [
        "__init__.py",
        "definition.py",
    ],
    visibility = [
        "//src/robo_arch:__subpackages__",
        "//tests/build:__pkg__",
    ],
    deps = [
        "//src/robo_arch/core/config",
        "//src/robo_arch/core/controllers",
        requirement("pydantic"),
    ],
)

py_library(
    name = "native",
    srcs = [
        "_docstrings.py",
        "native.py",
    ],
    visibility = [
        "//src/robo_arch:__subpackages__",
        "//tests/build:__pkg__",
    ],
    deps = [
        ":extension",
        ":joint_pd",
        requirement("numpy"),
    ],
)

py_library(
    name = "drake",
    srcs = ["drake.py"],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        ":joint_pd",
        ":native",
        requirement("drake"),
        requirement("numpy"),
    ],
)

py_test(
    name = "native_test",
    srcs = ["tests/test_native.py"],
    main = "tests/test_native.py",
    deps = [
        ":native",
        requirement("pytest"),
    ],
)

cc_test(
    name = "joint_pd_test",
    srcs = ["tests/joint_pd_test.cc"],
    deps = [
        ":joint_pd_cc",
        "@googletest//:gtest_main",
    ],
)

# Torch is provided by the independently locked Isaac vendor profile.
py_library(
    name = "tensor",
    srcs = ["tensor.py"],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [":joint_pd"],
)

py_test(
    name = "tensor_test",
    srcs = ["tests/test_tensor.py"],
    main = "tests/test_tensor.py",
    deps = [
        ":native",
        ":tensor",
        requirement("numpy"),
        requirement("pytest"),
    ],
)
