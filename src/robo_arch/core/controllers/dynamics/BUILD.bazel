load("@python_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "jax",
    srcs = [
        "__init__.py",
        "jax.py",
    ],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        "//src/robo_arch/core/controllers",
        requirement("jax"),
        requirement("jaxsim"),
        requirement("numpy"),
    ],
)

# Torch is only required when callers request the DLPack tensor boundary.
py_library(
    name = "torch",
    srcs = ["torch.py"],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [":jax"],
)

py_library(
    name = "drake",
    srcs = ["drake.py"],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        ":jax",
        requirement("drake"),
        requirement("numpy"),
        requirement("jax"),
        requirement("jaxsim"),
    ],
)

filegroup(
    name = "gpu_tests",
    srcs = ["tests/test_torch.py"],
)
