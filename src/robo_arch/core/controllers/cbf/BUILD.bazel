load("@python_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "cbf",
    srcs = [
        "__init__.py",
        "barrier.py",
        "definition.py",
    ],
    visibility = [
        "//src/robo_arch:__subpackages__",
        "//tests/build:__pkg__",
    ],
    deps = [
        "//src/robo_arch/core/controllers",
        requirement("numpy"),
    ],
)

py_library(
    name = "config",
    srcs = ["config.py"],
    visibility = [
        "//src/robo_arch:__subpackages__",
        "//tests/build:__pkg__",
    ],
    deps = [
        ":cbf",
        "//src/robo_arch/core/config",
        requirement("pydantic"),
    ],
)

py_library(
    name = "assembly",
    srcs = ["assembly.py"],
    visibility = [
        "//src/robo_arch:__subpackages__",
        "//tests/build:__pkg__",
    ],
    deps = [
        ":cbf",
        ":config",
        ":geometry",
        "//src/robo_arch/core/config",
        requirement("numpy"),
    ],
)

py_library(
    name = "geometry",
    srcs = ["geometry.py"],
    visibility = [
        "//src/robo_arch:__subpackages__",
        "//tests/build:__pkg__",
    ],
    deps = [
        ":cbf",
        "//src/robo_arch/core/config",
        requirement("numpy"),
        requirement("pydantic"),
    ],
)

py_library(
    name = "drake",
    srcs = ["drake.py"],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        ":assembly",
        ":cbf",
        ":config",
        requirement("drake"),
        requirement("numpy"),
    ],
)

py_test(
