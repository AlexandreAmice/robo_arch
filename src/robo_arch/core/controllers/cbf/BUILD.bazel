        requirement("pytest"),
    ],
)

py_test(
    name = "barrier_test",
    srcs = ["tests/test_barrier.py"],
    main = "tests/test_barrier.py",
    deps = [
        ":cbf",
        requirement("numpy"),
        requirement("pytest"),
    ],
)

py_test(
    name = "drake_test",
    srcs = ["tests/test_drake.py"],
    main = "tests/test_drake.py",
    deps = [
        ":assembly",
        ":cbf",
        ":config",
        ":drake",
