py_test(
    name = "geometry_test",
    srcs = ["tests/test_geometry.py"],
    main = "tests/test_geometry.py",
    deps = [
        ":geometry",
        requirement("numpy"),
        requirement("pytest"),
    ],
)

# Torch and Moreau are optional runtime providers pinned in the Isaac profile.
py_library(
    name = "tensor",
    srcs = [
        "moreau.py",
        "tensor.py",
    ],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        ":assembly",
        ":cbf",
        ":config",
        "//src/robo_arch/core/controllers/dynamics:torch",
    ],
)

filegroup(
    name = "gpu_tests",
    srcs = [
        "tests/test_moreau.py",
        "tests/test_tensor_barrier.py",
        "tests/test_tensor_filter.py",
    ],
