load("@python_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "config",
    srcs = [
        "__init__.py",
        "config.py",
    ],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        "//src/robo_arch/core/config:schema",
        "//src/robo_arch/core/worlds:package",
        requirement("pydantic"),
    ],
)

# Isaac Lab and Kit/PhysX are supplied by third_party/isaac, not the core Bazel environment.
py_library(
    name = "isaac",
    srcs = [
        "backend.py",
        "batched.py",
        "convert.py",
        "objects.py",
        "scenario.py",
        "scene.py",
        "urdf.py",
        "visualization.py",
    ],
    data = [
        "batch.yaml",
        "desktop.yaml",
        "newton.yaml",
        "physics.kit",
        "viewport.kit",
    ],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        ":config",
        "//src/robo_arch/core/config",
        "//src/robo_arch/core/worlds",
        requirement("numpy"),
    ],
)

py_test(
    name = "objects_test",
    srcs = ["tests/test_objects.py"],
    main = "tests/test_objects.py",
    deps = [
        ":config",
        ":isaac",
        "//src/robo_arch/core/config",
        "//src/robo_arch/core/worlds",
        "//src/robo_arch/objects/box",
        "//src/robo_arch/robots/ur7e",
        requirement("pytest"),
    ],
)

py_test(
    name = "execution_test",
    srcs = ["tests/test_execution.py"],
    main = "tests/test_execution.py",
    deps = [
        ":config",
        ":isaac",
        requirement("pytest"),
    ],
)

py_test(
    name = "ground_test",
    srcs = ["tests/test_ground.py"],
    main = "tests/test_ground.py",
    deps = [
        ":config",
        ":isaac",
        "//src/robo_arch/core/config",
        requirement("pytest"),
    ],
)

py_test(
    name = "batching_test",
    srcs = ["tests/test_batching.py"],
    main = "tests/test_batching.py",
    deps = [
        ":config",
        ":isaac",
        requirement("numpy"),
        requirement("pytest"),
    ],
)

py_test(
    name = "gpu_execution_test",
    srcs = ["tests/test_gpu_execution.py"],
    main = "tests/test_gpu_execution.py",
    deps = [
        ":config",
        ":isaac",
        "//src/robo_arch/core/config",
        "//src/robo_arch/robots/ur7e",
        requirement("numpy"),
