load("@python_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "config",
    srcs = [
        "__init__.py",
        "config.py",
    ],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        "//src/robo_arch/core/config:resources",
        "//src/robo_arch/core/config:schema",
        "//src/robo_arch/core/worlds:package",
        requirement("pydantic"),
    ],
)

py_library(
    name = "real",
    srcs = [
        "scenario.py",
        "scene.py",
        "visualization.py",
    ],
    data = ["inspection.rviz"],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        ":config",
        ":trajectory",
        "//src/robo_arch/core/config",
        "//src/robo_arch/core/contracts:commands",
        "//src/robo_arch/core/worlds:assembly",
        "//src/robo_arch/core/worlds:devices",
    ],
)

# ROS imports are lazy. Actual transport execution is tested in the pinned ROS
# underlay, not represented as an ordinary Bazel Python dependency environment.
py_library(
    name = "trajectory",
    srcs = ["trajectory.py"],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [":config"],
)

py_test(
    name = "visualization_test",
    srcs = ["tests/test_rviz.py"],
    main = "tests/test_rviz.py",
    deps = [
        ":config",
        ":real",
        "//src/robo_arch/core/config",
        requirement("pytest"),
    ],
)

py_binary(
    name = "inspect",
    srcs = ["visualization.py"],
    main = "visualization.py",
    deps = [":real"],
)
