load("@python_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "arm_tracking",
    srcs = [
        "__init__.py",
        "control.py",
        "drake.py",
        "evaluation.py",
        "isaac.py",
        "plotting.py",
        "run.py",
    ],
    data = glob(["**/*.yaml"]) + [
        "//src/robo_arch/robot_system/iiwa7_mini45:resources",
        "//src/robo_arch/robot_system/ur7e_d435:resources",
        "//src/robo_arch/robot_system/ur7e_iiwa7:resources",
    ],
    visibility = ["//src/robo_arch:__subpackages__"],
    deps = [
        "//src/robo_arch/core/config",
        "//src/robo_arch/core/controllers/joint_pd",
        "//src/robo_arch/core/controllers/joint_pd:drake",
        "//src/robo_arch/core/controllers/joint_tracking",
        "//src/robo_arch/core/controllers/joint_tracking:drake",
        "//src/robo_arch/core/worlds",
        "//src/robo_arch/core/worlds/drake",
        "//src/robo_arch/core/worlds/drake:config",
        "//src/robo_arch/core/worlds/isaac",
        "//src/robo_arch/core/worlds/isaac:config",
        "//src/robo_arch/objects/box",
        "//src/robo_arch/robots/iiwa7",
        "//src/robo_arch/robots/ur7e",
        "//src/robo_arch/scenarios",
        "//src/robo_arch/sensors/ati_mini45",
        "//src/robo_arch/sensors/ati_mini45/drake",
        "//src/robo_arch/sensors/ati_mini45/isaac",
        "//src/robo_arch/sensors/realsense_d435",
        "//src/robo_arch/sensors/realsense_d435/drake",
        requirement("drake"),
        requirement("numpy"),
        requirement("matplotlib"),
        requirement("pydantic"),
    ],
)

py_binary(
    name = "run",
    srcs = ["run.py"],
    main = "run.py",
    deps = [":arm_tracking"],
)

py_test(
    name = "run_test",
    srcs = ["tests/test_run.py"],
    main = "tests/test_run.py",
    deps = [
        ":arm_tracking",
        "//src/robo_arch/core/config",
        "//src/robo_arch/core/worlds",
        "//src/robo_arch/core/worlds/drake:config",
        "//src/robo_arch/core/worlds/isaac:config",
        "//src/robo_arch/core/worlds/real:config",
        requirement("numpy"),
        requirement("pytest"),
    ],
)

# Native integration needs an explicit vendor interpreter and NVIDIA driver.
py_test(
    name = "isaac_lab_test",
    size = "large",
    srcs = ["tests/test_isaac_lab.py"],
    main = "tests/test_isaac_lab.py",
    tags = [
        "local",
        "manual",
        "no-cache",
    ],
    deps = [
        ":arm_tracking",
        "//src/robo_arch/core/config",
        "//src/robo_arch/core/worlds/isaac",
        "//src/robo_arch/core/worlds/isaac:config",
        requirement("numpy"),
        requirement("pytest"),
    ],
)
