module(
    name = "robo_arch",
    version = "0.1.0",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_python", version = "2.3.4")
bazel_dep(name = "nanobind", version = "3.0.1")
bazel_dep(name = "toolchains_llvm", version = "1.10.0")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    patch_strip = 1,
    patches = ["//third_party/hedron:bazel9.patch"],
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "python_deps",
    python_version = "3.12.13",
    uv_lock = "//:uv.lock",
)
use_repo(pip, "python_deps")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "22.1.8",
)
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")
