{
    "clangd.path": "${workspaceFolder}/external/toolchains_llvm++llvm+llvm_toolchain_llvm/bin/clangd",
    "clangd.arguments": [
        "--header-insertion=never",
        "--compile-commands-dir=${workspaceFolder}"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "ltex.enabled": [
        "bibtex",
        "context",
        "context.tex",
        "latex",
        "markdown",
        "org",
        "restructuredtext",
        "rsweave"
    ]
}
